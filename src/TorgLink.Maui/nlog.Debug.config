<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      throwConfigExceptions="false"
      internalLogLevel="Off"
      autoReload="true">
  <!-- Debug build: Trace+ to file. MauiProgram remaps fileName to AppLogPaths.LogsDirectory. -->
  <targets>
    <target xsi:type="AsyncWrapper"
            name="async-gui-logfile"
            queueLimit="5000"
            overflowAction="Grow">
      <target xsi:type="File"
              name="gui-logfile"
              fileName="${basedir}/logs/${date:format=dd.MM.yyyy}.log"
              layout="${longdate}|${uppercase:${level}}|${logger}|${message}${onexception:inner=|${exception:format=tostring}}"
              keepFileOpen="false"
              concurrentWrites="true"
              createDirs="true"
              encoding="utf-8"/>
    </target>
  </targets>
  <rules>
    <logger name="*" minlevel="Trace" writeTo="async-gui-logfile"/>
  </rules>
</nlog>
